{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "name": "social-compass",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "bun run --parallel lint:ts lint:code",
    "lint:ts": "tsc --noEmit",
    "lint:code": "oxlint",
    "lint:code:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.63.0",
    "@mlc-ai/web-llm": "0.2.86",
    "@huggingface/transformers": "4.3.2"
  },
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "packageManager": "bun@1.4.4"
}
